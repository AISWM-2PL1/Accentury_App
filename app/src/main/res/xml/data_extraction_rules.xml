<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ 백업·기기 이전 규칙.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!--
      계정 토큰 (KAN-224, auth/KeystoreTokenStore.kt). 암호문을 푸는 Keystore 키는 백업·기기 이전으로
      따라가지 않으므로 파일만 옮겨지면 영영 못 푸는 값이 된다. 토큰을 기기 밖으로 내보내지 않는 것 자체도 목적이다.
    -->
    <cloud-backup>
        <exclude domain="file" path="datastore/auth_tokens.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth_tokens.preferences_pb" />
    </device-transfer>
</data-extraction-rules>

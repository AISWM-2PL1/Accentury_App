<?xml version="1.0" encoding="utf-8"?><!--
   Android 11 이하 자동 백업 규칙. 12+는 data_extraction_rules.xml을 본다.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!--
      계정 토큰 (KAN-224, auth/KeystoreTokenStore.kt). 암호문을 푸는 Keystore 키는 백업되지 않으므로
      파일만 복원되면 영영 못 푸는 값이 된다. 토큰을 기기 밖으로 내보내지 않는 것 자체도 목적이다.
    -->
    <exclude domain="file" path="datastore/auth_tokens.preferences_pb" />
</full-backup-content>

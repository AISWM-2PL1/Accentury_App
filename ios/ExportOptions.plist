<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ExportOptions.plist — 무서명 아카이브를 App Store Connect용으로 재서명해 꺼내는 설정 (KAN-175 3단계).

      xcodebuild archive … CODE_SIGNING_ALLOWED=NO
      xcodebuild -exportArchive -exportOptionsPlist ios/ExportOptions.plist -allowProvisioningUpdates

  이 두 단계로 갈린 이유는 팀에 등록된 기기가 0대라서다 — 자동 서명 archive가 개발용 프로파일을
  만들려다 막힌다. 판단 근거는 docs/wiki/ios-port.md §7 「TestFlight 서명」, 명령 전체는
  ios/README.md 「릴리스 아카이브·TestFlight」.

  아래 키 이름과 허용값은 `xcodebuild -help`의 "Available keys for -exportOptionsPlist" 절에서
  직접 확인했다 (Xcode 26.6 / 17F113, 2026-09-22). 이 목록은 Xcode 버전마다 바뀌고 틀린 키는
  조용히 무시되므로, Xcode를 올린 뒤 이 파일을 고칠 때 같은 절을 다시 본다.

  **팀 ID를 레포에 두는 이유.** Base.xcconfig가 팀 ID를 레포 밖(Local.xcconfig)에 두는 것은
  개발자 기기 빌드가 사람마다 다른 팀을 쓰기 때문이다. 스토어 export는 그 반대다 — 앱을 소유한
  팀 하나뿐이고, 그 값은 docs/wiki/ios-port.md §7과 app-store-listing.md §1에 이미 적혀 있다.
  팀 ID는 비밀이 아니다. 배포 인증서와 App Store Connect API 키가 없으면 이 값만으로 할 수
  있는 일이 없다.

  **업로드는 여기서 하지 않는다.** destination을 upload로 바꾸면 export가 곧바로 TestFlight로
  올라간다. 그 스위치는 4단계 릴리스 워크플로가 이 파일을 복사·수정하거나 별도 plist로 들고
  가고, 이 파일은 로컬·CI 공통의 export 정본으로 남긴다 — 아카이브가 되는지 보려고 돌린 빌드가
  빌드 번호를 태우는 일이 없게.
-->
<plist version="1.0">
<dict>
	<!-- App Store Connect 배포. app-store는 이 이름의 옛 별칭이고 -help가 deprecated로 적는다. -->
	<key>method</key>
	<string>app-store-connect</string>

	<!-- export = .ipa를 -exportPath에 떨군다 (기본값이지만 명시한다 — upload와 갈리는 지점이라
	     기본값에 기대면 읽는 사람이 어느 쪽인지 알 수 없다). -->
	<key>destination</key>
	<string>export</string>

	<!-- 무서명 아카이브를 받아 재서명하는 쪽이 automatic이다. -allowProvisioningUpdates와 짝을
	     이뤄 App ID·Apple Distribution 인증서·iOS Team Store Provisioning Profile을 스스로 만든다. -->
	<key>signingStyle</key>
	<string>automatic</string>

	<!-- 아카이브가 무서명이라 "아카이브를 만든 팀"이라는 기본값이 없다. 반드시 준다. -->
	<key>teamID</key>
	<string>559P9SYY57</string>

	<!-- dSYM을 함께 올려 Crashlytics·Organizer가 릴리스 크래시를 사람이 읽는 줄로 되돌린다. -->
	<key>uploadSymbols</key>
	<true/>

	<!-- 기본값 YES면 Xcode가 업로드 시점에 빌드 번호를 자기 마음대로 올린다. 그러면 레포의
	     CURRENT_PROJECT_VERSION과 스토어에 올라간 번호가 갈리고, 안드로이드 versionCode와
	     같이 올린다는 규칙(Base.xcconfig)이 무너진다. 번호는 우리가 커밋으로 정한다. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>

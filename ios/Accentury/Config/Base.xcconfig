// Base.xcconfig — Debug·Release가 공유하는 설정. 안드로이드의 app/build.gradle.kts
// `defaultConfig` 블록에 해당한다. 빌드 구성별로 갈리는 값만 Debug/Release.xcconfig가 덮는다.
//
// [xcconfig 주석 함정] 이 파일에서 `//`는 줄 끝까지 주석이다. URL의 `//`를 그대로 쓰면
// 스킴만 남고 잘리므로 빈 변수 참조 `$()`를 끼워 `http:/$()/localhost` 꼴로 쓴다
// (Debug/Release.xcconfig 참고). 이 파일에는 URL이 없지만 규칙은 같다.

PRODUCT_NAME = Accentury
PRODUCT_BUNDLE_IDENTIFIER = com.accentury.app

// 안드로이드 versionName/versionCode와 짝이고, **같은 커밋에서 같이 올린다** (KAN-175 3단계).
// `MARKETING_VERSION` = `versionName`, `CURRENT_PROJECT_VERSION` = `versionCode`다.
// 한쪽만 올리면 `AccenturyCoreTests/ReleaseVersionParityTests`가 두 파일을 직접 읽어 대조하다
// 실패한다 — 두 스토어에 서로 다른 버전이 나가는 것을 커밋 전에 막으려는 검사다.
//
// **왜 1이 아니라 7인가.** TestFlight에 1.0 빌드 5까지 올라가 있었고 (`docs/wiki/ios-port.md` §7),
// 빌드 6은 C2 아이콘으로 올라갔다 (2026-09-23). App Store Connect는 같은 `MARKETING_VERSION`
// 안에서 빌드 번호가 단조 증가할 때만 업로드를 받으므로 다음 업로드는 7부터이고, 7이 확정 도상
// D3를 싣는 첫 빌드다. 안드로이드 `versionCode`는 아직 어디에도 올라가지 않았지만 번호를 갈라
// 두면 규칙이 둘이 되니 같은 값으로 맞춘다.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 7

// minSdk 29(Android 10, 2019)와 대략 같은 시기·보급률 대의 하한.
IPHONEOS_DEPLOYMENT_TARGET = 16.0
// 1 = iPhone 전용. 안드로이드 쪽도 폰 세로 화면만 지원한다.
TARGETED_DEVICE_FAMILY = 1

SWIFT_VERSION = 5.0
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES

// 서명. 팀 ID는 레포에 넣지 않는다 — 개인 계정 식별자이고 사람마다 다르다.
// 실기기 빌드가 필요하면 Local.xcconfig(gitignore 대상)에 `ACCENTURY_TEAM_ID = ABCDE12345`를
// 적는다. 값이 없으면 빈 문자열이 되고, 시뮬레이터 빌드는 서명 없이 그대로 통과한다.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = $(ACCENTURY_TEAM_ID)

// 카카오 네이티브 앱 키 (KAN-180). 안드로이드 `app/build.gradle.kts`의 kakaoNativeAppKey()와
// 같은 자리이고 같은 판단이다 — **빈 값이 정상**이다. 비어 있으면 SDK를 초기화하지 않고 공유는
// OS 공유 시트로만 간다(AccenturyApp.swift · ResultSharer). 키가 없다는 걸 빌드 시점에 알 수
// 있으므로 카카오 경로를 아예 만들지 않는 편이, 사용자가 [공유하기]를 누른 뒤 인증 오류로
// 떨어지는 것보다 낫다.
//
// 값을 넣는 자리는 둘이다. 로컬은 아래 include가 읽는 Local.xcconfig(gitignore 대상)의
// `KAKAO_NATIVE_APP_KEY = ...`이고, 아카이브는 `xcodebuild ... KAKAO_NATIVE_APP_KEY=...`처럼
// 명령줄 빌드 설정으로 준다(명령줄이 xcconfig보다 우선한다). **레포에는 두지 않는다.**
//
// 이 include '앞'에 있어야 Local.xcconfig가 덮을 수 있다. Release.xcconfig는 Local을 다시
// 읽지 않으므로(그쪽 주석 참고) 릴리스 빌드가 이 키를 받는 경로도 이 한 줄과 명령줄뿐이다.
KAKAO_NATIVE_APP_KEY =

// AdMob 앱 ID·광고 단위 ID 셋 (KAN-196). 안드로이드 `app/build.gradle.kts`의 admobAppId()·
// admobInterstitialId()·admobRewardedId()와 같은 자리이고 **기본값이 Google 테스트 ID**다 —
// 카카오 키와 갈리는 지점이다. 카카오는 빈 키로 기능을 끄지만 광고는 테스트 ID로 켜 둔다:
// 광고 없는 빌드는 대기 화면·재응시의 광고 결선을 한 번도 밟지 않아 검증이 안 되고, Google이
// 테스트 ID를 주는 이유가 정확히 그것이다 (developers.google.com/admob/ios/test-ads).
//
// 값을 넣는 자리는 카카오 키와 같다 — 로컬은 Local.xcconfig, 아카이브는 명령줄
// `xcodebuild ... ADMOB_APP_ID=... ADMOB_INTERSTITIAL_ID=... ADMOB_REWARDED_ID=...`.
// 테스트 ID가 스토어로 나가는 것은 `REQUIRE_ADMOB_IDS=YES` 빗장이 막는다 (project.yml).
// 앱 ID는 Info-*.plist의 GADApplicationIdentifier로, 단위 ID 둘은 같은 plist를 거쳐
// AppConfig.swift로 흐른다 (WEB_URL과 같은 사슬).
ADMOB_APP_ID = ca-app-pub-3940256099942544~1458002511
ADMOB_INTERSTITIAL_ID = ca-app-pub-3940256099942544/4411468910
ADMOB_REWARDED_ID = ca-app-pub-3940256099942544/1712485313

// 로그인 IdP 설정 여섯 (KAN-224). 안드로이드 `app/build.gradle.kts`의 idpProperty()(googleServerClientId·
// naverClientId·naverClientSecret)와 같은 자리이고 카카오 키와 같은 판단이다 — **빈 값이 정상**이다. 값이 빈
// IdP는 로그인 화면에서 버튼을 숨긴다(Auth/IdpSdks.swift). 로컬 개발은 Debug.xcconfig의 FAKE_IDP로 SDK 없이 돈다.
//
//   GOOGLE_IOS_CLIENT_ID        구글 콘솔 "iOS" OAuth 클라이언트 ID (SDK가 계정 선택 화면을 여는 데 쓴다)
//   GOOGLE_SERVER_CLIENT_ID     구글 콘솔 "웹 애플리케이션" 클라이언트 ID — 안드로이드와 같은 값. ID 토큰의 aud가
//                               이 값이 되고 서버가 대조한다
//   GOOGLE_REVERSED_CLIENT_ID   iOS 클라이언트 ID를 거꾸로 쓴 URL 스킴 (`com.googleusercontent.apps.<번호>`)
//   NAVER_CLIENT_ID·NAVER_CLIENT_SECRET  네이버 개발자 센터 앱 — 안드로이드와 같은 앱의 같은 값. 시크릿이 앱에 박히는
//                               것은 네이버 SDK의 설계다(기기에서 토큰 교환을 한다)
//   NAVER_URL_SCHEME            네이버 앱 로그인이 우리 앱으로 돌아오는 스킴. 네이버 콘솔 iOS 설정의 "URL Scheme"과 같아야 한다
//
// 값을 넣는 자리는 카카오 키와 같다 — 로컬은 Local.xcconfig, 아카이브는 명령줄 `xcodebuild ... GOOGLE_IOS_CLIENT_ID=...`.
// 스토어 빌드가 빈 값으로 나가는 것은 `REQUIRE_IDP_CONFIG=YES` 빗장이 막는다 (project.yml).
GOOGLE_IOS_CLIENT_ID =
GOOGLE_SERVER_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID =
NAVER_CLIENT_ID =
NAVER_CLIENT_SECRET =
NAVER_URL_SCHEME =

// 가짜 IdP (KAN-224). Release는 늘 NO다 — Release.xcconfig가 Local.xcconfig 뒤에서 다시 못 박는다. 켜는 자리는
// Debug.xcconfig 주석 참고. Info-Release.plist에는 키 자체가 없고 읽는 코드도 `#if DEBUG`다.
FAKE_IDP = NO

// 여기서 Local.xcconfig를 한 번 읽는 이유는 ACCENTURY_TEAM_ID 하나 때문이다 — Release도
// 팀 ID는 필요하다. WEB_URL·API_BASE_URL 오버라이드는 이 지점이 아니라 Debug.xcconfig 끝의
// 두 번째 `#include?`가 담당한다. Release의 URL은 이 include '뒤'에 놓여 있어(Release.xcconfig)
// 로컬 파일이 프로덕션 빌드의 주소를 조용히 바꿀 수 없다.
#include? "Local.xcconfig"
